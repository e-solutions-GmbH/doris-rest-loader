{
  "$schema": "https://raw.githubusercontent.com/todogroup/repolinter/master/rulesets/schema.json",
  "version": 2,
  "axioms": {},
  "rules": {
    "license-file-exists": {
      "level": "error",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": ["LICENSE*", "COPYING*"],
          "nocase": true
        }
      }
    },
    "readme-file-exists": {
      "level": "error",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": ["README*"],
          "nocase": true
        }
      }
    },
    "contributing-file-exists": {
      "level": "error",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": [
            "{docs/,.github/,}CONTRIBUTING*"
          ],
          "nocase": true
        }
      }
    },
    "code-of-conduct-file-exists": {
      "level": "error",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": [
            "{docs/,.github/,}CODE_OF_CONDUCT*",
            "{docs/,.github/,}CODEOFCONDUCT*"
          ],
          "nocase": true
        }
      }
    },
    "security-file-exists": {
      "level": "error",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": [
            "{docs/,.github/,}SECURITY*"
          ],
          "nocase": true
        }
      }
    },
    "changelog-file-exists": {
      "level": "off",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": ["CHANGELOG*", "changelog*"],
          "nocase": true
        }
      }
    },
    "support-file-exists": {
      "level": "off",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": [
            "{docs/,.github/,}SUPPORT*"
          ],
          "nocase": true
        }
      }
    },
    "readme-references-license": {
      "level": "error",
      "rule": {
        "type": "file-contents",
        "options": {
          "globsAll": ["README*"],
          "content": "license",
          "flags": "i",
          "human-readable-content": "the string 'license'"
        }
      }
    },
    "binaries-not-present": {
      "level": "error",
      "rule": {
        "type": "file-type-exclusion",
        "options": {
          "type": [
            "**/*.exe",
            "**/*.dll",
            "**/*.dylib",
            "**/*.class",
            "**/*.jar"
          ]
        }
      }
    },
    "test-directory-exists": {
      "level": "warning",
      "rule": {
        "type": "directory-existence",
        "options": {
          "globsAny": [
            "**/test*",
            "**/*_test.go",
            "**/spec*"
          ],
          "nocase": true
        }
      }
    },
    "integrates-with-ci": {
      "level": "error",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": [
            ".github/workflows/*.yml",
            ".github/workflows/*.yaml",
            ".gitlab-ci.yml",
            ".travis.yml",
            "circle.yml",
            ".circleci/config.yml"
          ]
        }
      }
    },
    "code-of-conduct-contains-email": {
      "level": "error",
      "rule": {
        "type": "file-contents",
        "options": {
          "globsAll": ["{docs/,.github/,}CODE_OF_CONDUCT*"],
          "content": "[\\w.+-]+@[\\w-]+\\.[\\w.-]+",
          "flags": "i",
          "human-readable-content": "a contact email address"
        }
      }
    },
    "notice-file-exists": {
      "level": "off",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": ["NOTICE*"],
          "nocase": true
        }
      }
    }
  }
}
